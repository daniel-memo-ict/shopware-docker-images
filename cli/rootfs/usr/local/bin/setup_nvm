#!/usr/bin/env bash

if [[ -e /nvm/versions/ ]]; then
  rm -rf /nvm/*
  rm -rf /nvm/.cache
fi

if [[ ! -e /nvm/.debian-fnm/ ]]; then
  fnm --fnm-dir=/nvm/.debian-fnm install 20
  # shellcheck disable=SC2046
  eval $(fnm --fnm-dir=/nvm/.debian-fnm env --shell=bash)
  fnm use 20
else
  # shellcheck disable=SC2046
  eval $(fnm --fnm-dir=/nvm/.debian-fnm env --shell=bash)
fi